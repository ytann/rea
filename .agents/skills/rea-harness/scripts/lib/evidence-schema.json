{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rea.local/schemas/evidence-bundle/1.0.json",
  "title": "REA Harness Evidence Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "readiness",
    "run",
    "facts",
    "flows",
    "systems",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "target": {
      "type": "object",
      "required": ["kind", "format", "source"],
      "properties": {
        "kind": { "type": "string" },
        "format": { "type": "string" },
        "source": { "type": "string" },
        "digest": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "readiness": {
      "type": "object",
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run": {
      "type": "object",
      "required": ["started_at"],
      "properties": {
        "started_at": { "type": "string" },
        "completed_at": { "type": "string" },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "claim", "evidence_class", "source"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "claim": { "type": "string" },
          "evidence_class": { "enum": ["obs", "der", "inf", "unk"] },
          "source": { "type": "string" }
        }
      }
    },
    "flows": {
      "type": "object",
      "required": ["upstream", "downstream", "telemetry"],
      "properties": {
        "upstream": { "type": "array" },
        "downstream": { "type": "array" },
        "telemetry": { "type": "array" }
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "justification", "evidence_class"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "justification": { "type": "string" },
          "evidence_class": { "enum": ["obs", "der", "inf", "unk"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
